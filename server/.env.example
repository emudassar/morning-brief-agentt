# Copy to .env for local development. On Render, set these in the dashboard instead.
PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
OPENWEATHER_API_KEY=
NEWSDATA_API_KEY=
# Deployed frontend URL (used for CORS), no trailing slash
CLIENT_URL=https://morning-brief-frontend.vercel.app
LEMONSQUEEZY_WEBHOOK_SECRET=
# Optional: enables GET /debug/scheduler
DEBUG_SCHEDULER_SECRET=
